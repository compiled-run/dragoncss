# Generated outputs of `pnpm regen` (scripts/regen.ts): a merge keeps this side of each, and `pnpm regen` then rebuilds them
# from the merged sources. The driver needs `pnpm setup:git` once per clone; without it git merges these files as text.
# packages/parity/test/regen.test.ts keeps this list equal to the regen steps' outputs, sorted, so features add lines in different places.
THIRD_PARTY_NOTICES.md merge=dragon-generated
examples/music-player/dragon/north-star-check.json merge=dragon-generated
packages/dragon/src/css/grammar.generated.ts merge=dragon-generated
packages/dragon/src/profiles/android.ts merge=dragon-generated
packages/dragon/src/profiles/ios.ts merge=dragon-generated
packages/dragon/src/profiles/native-lanes.ts merge=dragon-generated
packages/dragon/src/profiles/web.ts merge=dragon-generated
packages/dragon/src/ua/*.generated.ts merge=dragon-generated
packages/layout/break-vectors/** merge=dragon-generated
packages/layout/generated/** merge=dragon-generated
packages/layout/paint-vectors/*/vectors.json merge=dragon-generated
packages/layout/paint-vectors/radius/inputs.jsonl merge=dragon-generated
packages/layout/paint-vectors/shadow/inputs.jsonl merge=dragon-generated
packages/layout/rt-vectors/animator/** merge=dragon-generated
packages/layout/rt-vectors/hit/** merge=dragon-generated
packages/layout/vectors/*.json merge=dragon-generated
packages/layout/vectors/dpr-*/** merge=dragon-generated
packages/parity/emitted/** merge=dragon-generated
packages/parity/expected-breaks/** merge=dragon-generated
packages/parity/expected-dpr/** merge=dragon-generated
packages/parity/expected-env/** merge=dragon-generated
