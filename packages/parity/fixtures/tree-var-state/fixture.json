    "textTopology": [
      { "address": "label:text0", "component": "App", "template": "label-text", "at": "AB CD", "ownerInstance": "doc", "insertionParent": "label", "context": { "ltr": "text-in-flex-item/column/ltr", "rtl": "text-in-flex-item/column/rtl" } }
    ]
