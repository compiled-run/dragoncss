{
  "sources": ["view.dg", "doc.css", "app.css", "list.css"],
  "modules": [{ "id": "view", "source": "view.dg" }],
  "styles": [
    { "id": "doc", "file": "doc.css", "scope": "document" },
    { "id": "app", "file": "app.css", "scope": "App" },
    { "id": "list", "file": "list.css", "scope": "List" }
  ],
  "document": { "root": "App", "documentElement": "html", "styles": ["doc", "app", "list"] },
  "components": [
    {
      "id": "App", "module": "view", "at": "component App",
      "states": [{ "id": "count", "domain": ["one", "two", "three"], "initial": "two", "at": "count: \"one\" | \"two\" | \"three\" = \"two\"" }],
      "root": [
        { "el": "html", "id": "html", "at": "<html>", "children": [
          { "el": "body", "id": "body", "at": "<body>", "children": [
            { "call": "List", "id": "list", "at": "<List list>", "slots": {
              "items": [
                { "el": "div", "id": "a", "at": "<div a", "class": ["app.row"] },
                { "if": { "not": ["count", "one"] }, "id": "has-b", "at": "{count !== \"one\"", "then": [{ "el": "div", "id": "b", "at": "<div b", "class": ["app.row"] }], "else": [] },
                { "if": ["count", "three"], "id": "has-c", "at": "{count === \"three\"", "then": [{ "el": "div", "id": "c", "at": "<div c", "class": ["app.row"] }], "else": [] }
              ]
            } },
            { "el": "div", "id": "blank", "at": "<div blank", "class": ["doc.blank"], "children": [{ "text": " ", "id": "space", "at": "{\" \"}" }] },
            { "el": "div", "id": "void", "at": "<div void", "class": ["doc.blank"] }
          ] }
        ] }
      ]
    },
    {
      "id": "List", "module": "view", "at": "component List",
      "slots": [{ "name": "items", "at": "items)" }],
      "root": [
        { "el": "div", "id": "frame", "at": "<div frame", "class": ["list.frame"], "children": [
          { "el": "div", "id": "head", "at": "<div head", "class": ["list.head"] },
          { "slot": "items", "id": "items-slot", "at": "{items}" },
          { "el": "div", "id": "foot", "at": "<div foot", "class": ["list.foot"] }
        ] }
      ]
    }
  ],
  "expected": {
    "freeStates": [{ "instance": "doc", "state": "count", "domain": ["one", "two", "three"] }],
    "cases": 3,
    "initial": [{ "instance": "doc", "state": "count", "value": "two" }],
    "textTopology": []
  }
}
