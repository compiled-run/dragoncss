component App(side: "rtl" | "ltr" | "none" = "rtl") {
  <html>
    <body>
      <div frame class="frame" dir={side === "none" ? null : side}>
        <div kid class="kid" />
        <div own class="own" dir="ltr">
          <div deep class="kid" />
        </div>
      </div>
      <div after class="kid" />
    </body>
  </html>
}
