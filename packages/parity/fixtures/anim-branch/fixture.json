{
 "sources": [
  "view.dg",
  "doc.css",
  "view.css"
 ],
 "modules": [
  {
   "id": "view",
   "source": "view.dg"
  }
 ],
 "styles": [
  {
   "id": "doc",
   "file": "doc.css",
   "scope": "document"
  },
  {
   "id": "view",
   "file": "view.css",
   "scope": "App"
  }
 ],
 "document": {
  "root": "App",
  "documentElement": "html",
  "styles": [
   "doc",
   "view"
  ]
 },
 "components": [
  {
   "id": "App",
   "module": "view",
   "at": "component App",
   "states": [
    {
     "id": "show",
     "domain": [
      false,
      true
     ],
     "initial": false,
     "at": "show: [false, true] = false"
    },
    {
     "id": "on",
     "domain": [
      false,
      true
     ],
     "initial": false,
     "at": "on: [false, true] = false"
    }
   ],
   "root": [
    {
     "el": "html",
     "id": "html",
     "at": "<html>",
     "children": [
      {
       "el": "body",
       "id": "body",
       "at": "<body>",
       "children": [
        {
         "el": "div",
         "id": "host",
         "at": "<div host",
         "class": [
          "view.host",
          {
           "choice": [
            {
             "when": [
              "on",
              true
             ],
             "class": "view.on"
            },
            {
             "when": {
              "not": [
               "on",
               true
              ]
             },
             "class": null
            }
           ],
           "at": "{on === true ? 'on' : ''}"
          }
         ],
         "children": [
          {
           "if": [
            "show",
            true
           ],
           "id": "b",
           "at": "{show === true && <b>}",
           "then": [
            {
             "el": "div",
             "id": "made",
             "at": "<div made",
             "class": [
              "view.made",
              {
               "choice": [
                {
                 "when": [
                  "on",
                  true
                 ],
                 "class": "view.on"
                },
                {
                 "when": {
                  "not": [
                   "on",
                   true
                  ]
                 },
                 "class": null
                }
               ],
               "at": "{on === true ? 'on' : ''}"
              }
             ]
            }
           ],
           "else": []
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
