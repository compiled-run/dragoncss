{
 "sources": [
  "view.dg",
  "doc.css",
  "view.css"
 ],
 "modules": [
  {
   "id": "view",
   "source": "view.dg"
  }
 ],
 "styles": [
  {
   "id": "doc",
   "file": "doc.css",
   "scope": "document"
  },
  {
   "id": "view",
   "file": "view.css",
   "scope": "App"
  }
 ],
 "document": {
  "root": "App",
  "documentElement": "html",
  "styles": [
   "doc",
   "view"
  ]
 },
 "components": [
  {
   "id": "App",
   "module": "view",
   "at": "component App",
   "states": [
    {
     "id": "list",
     "domain": [
      "two",
      "one"
     ],
     "initial": "two",
     "at": "list: [\"two\", \"one\"] = \"two\""
    },
    {
     "id": "ph",
     "domain": [
      "run",
      "later"
     ],
     "initial": "run",
     "at": "ph: [\"run\", \"later\"] = \"run\""
    }
   ],
   "root": [
    {
     "el": "html",
     "id": "html",
     "at": "<html>",
     "children": [
      {
       "el": "body",
       "id": "body",
       "at": "<body>",
       "children": [
        {
         "el": "div",
         "id": "lst",
         "at": "<div lst",
         "class": [
          "view.lst",
          {
           "choice": [
            {
             "when": [
              "list",
              "one"
             ],
             "class": "view.one"
            },
            {
             "when": {
              "not": [
               "list",
               "one"
              ]
             },
             "class": null
            }
           ],
           "at": "{list === \"one\" ? 'one' : ''}"
          }
         ]
        },
        {
         "el": "div",
         "id": "ph",
         "at": "<div ph",
         "class": [
          "view.ph",
          {
           "choice": [
            {
             "when": [
              "ph",
              "later"
             ],
             "class": "view.later"
            },
            {
             "when": {
              "not": [
               "ph",
               "later"
              ]
             },
             "class": null
            }
           ],
           "at": "{ph === \"later\" ? 'later' : ''}"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
