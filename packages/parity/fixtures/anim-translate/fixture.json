{
 "sources": [
  "view.dg",
  "doc.css",
  "view.css"
 ],
 "modules": [
  {
   "id": "view",
   "source": "view.dg"
  }
 ],
 "styles": [
  {
   "id": "doc",
   "file": "doc.css",
   "scope": "document"
  },
  {
   "id": "view",
   "file": "view.css",
   "scope": "App"
  }
 ],
 "document": {
  "root": "App",
  "documentElement": "html",
  "styles": [
   "doc",
   "view"
  ]
 },
 "components": [
  {
   "id": "App",
   "module": "view",
   "at": "component App",
   "states": [
    {
     "id": "open",
     "domain": [
      false,
      true
     ],
     "initial": false,
     "at": "open: [false, true] = false"
    }
   ],
   "root": [
    {
     "el": "html",
     "id": "html",
     "at": "<html>",
     "children": [
      {
       "el": "body",
       "id": "body",
       "at": "<body>",
       "children": [
        {
         "el": "div",
         "id": "track",
         "at": "<div track",
         "class": [
          "view.track"
         ],
         "children": [
          {
           "el": "div",
           "id": "thumb",
           "at": "<div thumb",
           "class": [
            "view.thumb",
            {
             "choice": [
              {
               "when": [
                "open",
                true
               ],
               "class": "view.on"
              },
              {
               "when": {
                "not": [
                 "open",
                 true
                ]
               },
               "class": null
              }
             ],
             "at": "{open === true ? 'on' : ''}"
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
