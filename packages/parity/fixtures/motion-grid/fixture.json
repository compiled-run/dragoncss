{
 "sources": [
  "view.dg",
  "doc.css",
  "view.css"
 ],
 "modules": [
  {
   "id": "view",
   "source": "view.dg"
  }
 ],
 "styles": [
  {
   "id": "doc",
   "file": "doc.css",
   "scope": "document"
  },
  {
   "id": "view",
   "file": "view.css",
   "scope": "App"
  }
 ],
 "document": {
  "root": "App",
  "documentElement": "html",
  "styles": [
   "doc",
   "view"
  ]
 },
 "components": [
  {
   "id": "App",
   "module": "view",
   "at": "component App",
   "states": [
    {
     "id": "on",
     "domain": [
      false,
      true
     ],
     "initial": false,
     "at": "on: [false, true] = false"
    }
   ],
   "root": [
    {
     "el": "html",
     "id": "html",
     "at": "<html>",
     "children": [
      {
       "el": "body",
       "id": "body",
       "at": "<body>",
       "children": [
        {
         "el": "div",
         "id": "g60",
         "at": "<div g60",
         "class": [
          "view.g",
          {
           "choice": [
            {
             "when": [
              "on",
              true
             ],
             "class": "view.on"
            },
            {
             "when": {
              "not": [
               "on",
               true
              ]
             },
             "class": null
            }
           ],
           "at": "{on === true ? 'on' : ''}"
          }
         ]
        },
        {
         "el": "div",
         "id": "g120",
         "at": "<div g120",
         "class": [
          "view.g",
          "view.g2",
          {
           "choice": [
            {
             "when": [
              "on",
              true
             ],
             "class": "view.on"
            },
            {
             "when": {
              "not": [
               "on",
               true
              ]
             },
             "class": null
            }
           ],
           "at": "{on === true ? 'on' : ''}"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
