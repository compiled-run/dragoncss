{
 "sources": [
  "view.dg",
  "doc.css",
  "view.css"
 ],
 "modules": [
  {
   "id": "view",
   "source": "view.dg"
  }
 ],
 "styles": [
  {
   "id": "doc",
   "file": "doc.css",
   "scope": "document"
  },
  {
   "id": "view",
   "file": "view.css",
   "scope": "App"
  }
 ],
 "document": {
  "root": "App",
  "documentElement": "html",
  "styles": [
   "doc",
   "view"
  ]
 },
 "components": [
  {
   "id": "App",
   "module": "view",
   "at": "component App",
   "states": [
    {
     "id": "on",
     "domain": [
      false,
      true
     ],
     "initial": false,
     "at": "on: [false, true] = false"
    },
    {
     "id": "hide",
     "domain": [
      false,
      true
     ],
     "initial": false,
     "at": "hide: [false, true] = false"
    }
   ],
   "root": [
    {
     "el": "html",
     "id": "html",
     "at": "<html>",
     "children": [
      {
       "el": "body",
       "id": "body",
       "at": "<body>",
       "children": [
        {
         "el": "div",
         "id": "wrap",
         "at": "<div wrap",
         "class": [
          "view.wrap",
          {
           "choice": [
            {
             "when": [
              "hide",
              true
             ],
             "class": "view.hide"
            },
            {
             "when": {
              "not": [
               "hide",
               true
              ]
             },
             "class": null
            }
           ],
           "at": "{hide === true ? 'hide' : ''}"
          }
         ],
         "children": [
          {
           "el": "div",
           "id": "box",
           "at": "<div box",
           "class": [
            "view.box",
            {
             "choice": [
              {
               "when": [
                "on",
                true
               ],
               "class": "view.on"
              },
              {
               "when": {
                "not": [
                 "on",
                 true
                ]
               },
               "class": null
              }
             ],
             "at": "{on === true ? 'on' : ''}"
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
