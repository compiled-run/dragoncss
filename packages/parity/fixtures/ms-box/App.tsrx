export function App() @{
	<div class="card">
		<style>
			.card { width: 120px; margin: 6px 8px; padding: 4px 10px 6px 2px; border: 3px solid #2a6; border-radius: 8px; background-color: #fe8; }
			.swatch { height: 20px; margin: 2px 4px; border-width: 1px 2px 3px 4px; border-style: solid; border-color: #000 #c00 #0c0 #00c; border-radius: 4px 0 6px 2px; background-color: rgb(30 60 200); }
		</style>
		<div class="swatch"></div>
	</div>
}
