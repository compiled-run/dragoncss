{
  "sources": ["app.dg", "doc.css", "toggle.css"],
  "modules": [{ "id": "app", "source": "app.dg" }],
  "styles": [{ "id": "doc", "file": "doc.css", "scope": "document" }, { "id": "toggle", "file": "toggle.css", "scope": "Toggle" }],
  "document": { "root": "App", "documentElement": "html", "styles": ["doc", "toggle"] },
  "components": [
    { "id": "App", "module": "app", "at": "component App", "root": [
      { "el": "html", "id": "html", "at": "<html>", "children": [{ "el": "body", "id": "body", "at": "<body>", "children": [
        { "call": "Toggle", "id": "t", "at": "<Toggle t />" }
      ] }] }
    ] },
    { "id": "Toggle", "module": "app", "at": "component Toggle",
      "states": [{ "id": "checked", "domain": [false, true], "initial": false, "at": "checked: boolean = false" }],
      "root": [{ "el": "div", "id": "box", "at": "<div box", "class": [
        "toggle.toggle",
        { "when": ["hovered", true], "class": "toggle.on", "at": "hovered ? 'on' : ''" }
      ] }] }
  ]
}
