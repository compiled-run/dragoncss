{
 "sources": ["view.dg", "doc.css", "view.css"],
 "modules": [{ "id": "view", "source": "view.dg" }],
 "styles": [{ "id": "doc", "file": "doc.css", "scope": "document" }, { "id": "view", "file": "view.css", "scope": "App" }],
 "document": { "root": "App", "documentElement": "html", "styles": ["doc", "view"] },
 "components": [
  { "id": "App", "module": "view", "at": "component App",
   "states": [{ "id": "hold", "domain": [false, true], "initial": false, "at": "hold: [false, true] = false" }],
   "root": [
    { "el": "html", "id": "html", "at": "<html>", "children": [{ "el": "body", "id": "body", "at": "<body>", "children": [
     { "el": "div", "id": "rec", "at": "<div rec", "class": [
      "view.rec",
      { "choice": [{ "when": ["hold", true], "class": "view.hold" }, { "when": { "not": ["hold", true] }, "class": null }], "at": "{hold === true ? 'hold' : ''}" }
     ] }
    ] }] }
   ] }
 ]
}
