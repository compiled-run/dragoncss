{
 "sources": [
  "view.dg",
  "doc.css",
  "view.css"
 ],
 "modules": [
  {
   "id": "view",
   "source": "view.dg"
  }
 ],
 "styles": [
  {
   "id": "doc",
   "file": "doc.css",
   "scope": "document"
  },
  {
   "id": "view",
   "file": "view.css",
   "scope": "App"
  }
 ],
 "document": {
  "root": "App",
  "documentElement": "html",
  "styles": [
   "doc",
   "view"
  ]
 },
 "components": [
  {
   "id": "App",
   "module": "view",
   "at": "component App",
   "states": [
    {
     "id": "open",
     "domain": [
      false,
      true
     ],
     "initial": false,
     "at": "open: [false, true] = false"
    }
   ],
   "root": [
    {
     "el": "html",
     "id": "html",
     "at": "<html>",
     "children": [
      {
       "el": "body",
       "id": "body",
       "at": "<body>",
       "children": [
        {
         "el": "div",
         "id": "app",
         "at": "<div app",
         "class": [
          "view.app",
          {
           "choice": [
            {
             "when": [
              "open",
              true
             ],
             "class": "view.open"
            },
            {
             "when": {
              "not": [
               "open",
               true
              ]
             },
             "class": null
            }
           ],
           "at": "{open === true ? 'open' : ''}"
          }
         ],
         "children": [
          {
           "el": "div",
           "id": "item",
           "at": "<div item",
           "class": [
            "view.item"
           ],
           "children": [
            {
             "text": "X",
             "id": "item-t",
             "at": "X"
            }
           ]
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
