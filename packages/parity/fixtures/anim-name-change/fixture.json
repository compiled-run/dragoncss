{
 "sources": [
  "view.dg",
  "doc.css",
  "view.css"
 ],
 "modules": [
  {
   "id": "view",
   "source": "view.dg"
  }
 ],
 "styles": [
  {
   "id": "doc",
   "file": "doc.css",
   "scope": "document"
  },
  {
   "id": "view",
   "file": "view.css",
   "scope": "App"
  }
 ],
 "document": {
  "root": "App",
  "documentElement": "html",
  "styles": [
   "doc",
   "view"
  ]
 },
 "components": [
  {
   "id": "App",
   "module": "view",
   "at": "component App",
   "states": [
    {
     "id": "mode",
     "domain": [
      "a",
      "b",
      "slow"
     ],
     "initial": "a",
     "at": "mode: [\"a\", \"b\", \"slow\"] = \"a\""
    }
   ],
   "root": [
    {
     "el": "html",
     "id": "html",
     "at": "<html>",
     "children": [
      {
       "el": "body",
       "id": "body",
       "at": "<body>",
       "children": [
        {
         "el": "div",
         "id": "box",
         "at": "<div box",
         "class": [
          "view.box",
          {
           "choice": [
            {
             "when": [
              "mode",
              "b"
             ],
             "class": "view.b"
            },
            {
             "when": {
              "not": [
               "mode",
               "b"
              ]
             },
             "class": null
            }
           ],
           "at": "{mode === \"b\" ? 'b' : ''}"
          },
          {
           "choice": [
            {
             "when": [
              "mode",
              "slow"
             ],
             "class": "view.slow"
            },
            {
             "when": {
              "not": [
               "mode",
               "slow"
              ]
             },
             "class": null
            }
           ],
           "at": "{mode === \"slow\" ? 'slow' : ''}"
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  }
 ]
}
