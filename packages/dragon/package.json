{
  "name": "dragon",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Regular CSS for native apps, tested against the browser.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "dragon-internal": "./src/internal.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "types": "./build/index.d.ts"
  },
  "dependencies": {
    "css-tree": "3.2.1"
  },
  "devDependencies": {
    "@dragon/layout": "workspace:*"
  }
}
