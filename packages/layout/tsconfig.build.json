{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    "composite": false,
    "incremental": false,
    "emitDeclarationOnly": false,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "removeComments": true,
    "stripInternal": true
  },
  "include": ["src"]
}
