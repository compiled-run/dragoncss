    "states": [
      {"call":".target","matched":10,"tree":{"t":"html","a":[],"c":[{"t":"head","a":[],"c":[{"t":"title","a":[],"c":["Tests that chain of elements that anchor to each other using anchor() and position-area works."]},"\n\n",{"t":"link","a":[["rel","help"],["href","https://drafts.csswg.org/css-anchor-position-1/#determining"]],"c":[]},"\n",{"t":"link","a":[["rel","author"],["title","Kiet Ho"],["href","mailto:kiet.ho@apple.com"]],"c":[]},"\n\n","\n","\n","\n","\n\n",{"t":"style","a":[],"c":["\n  .containing-block {\n    border: 1px solid black;\n\n    position: relative;\n    width: 700px;\n    height: 500px;\n  }\n\n  .box {\n    width: 50px;\n    height: 50px;\n    position: absolute;\n    anchor-name: --box;\n\n    color: white;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  #box1 {\n    top: 0;\n    left: 0;\n    background: green;\n  }\n\n  .uses-anchor-function {\n    background: blue;\n    position-anchor: --box;\n    left: calc(anchor(right) + 10px);\n  }\n\n  .uses-position-area {\n    background: magenta;\n    position-anchor: --box;\n    position-area: right center;\n    margin-left: 10px;\n  }\n"]},"\n\n"]},{"t":"body","a":[["onload","checkLayoutForAnchorPos('.target')"]],"c":["\n  ",{"t":"p","a":[],"c":["You should see a row of boxes in order."]},"\n\n  ",{"t":"div","a":[["class","containing-block"]],"c":["\n    ",{"t":"div","a":[["class","target box"],["id","box1"],["data-offset-x","0"]],"c":["1"],"v":{"offset-x":0}},"\n\n    ",{"t":"div","a":[["class","target box uses-position-area"],["data-offset-x","60"]],"c":["2"],"v":{"offset-x":60}},"\n    ",{"t":"div","a":[["class","target box uses-position-area"],["data-offset-x","120"]],"c":["3"],"v":{"offset-x":120}},"\n\n    ",{"t":"div","a":[["class","target box uses-anchor-function"],["data-offset-x","180"]],"c":["4"],"v":{"offset-x":180}},"\n    ",{"t":"div","a":[["class","target box uses-anchor-function"],["data-offset-x","240"]],"c":["5"],"v":{"offset-x":240}},"\n\n  