    "states": [
      {"call":".target","matched":5,"tree":{"t":"html","a":[],"c":[{"t":"head","a":[],"c":[{"t":"title","a":[],"c":["Tests that chain of elements that anchor to each other using anchor-size() works."]},"\n\n",{"t":"link","a":[["rel","help"],["href","https://drafts.csswg.org/css-anchor-position-1/#anchor-size-fn"]],"c":[]},"\n",{"t":"link","a":[["rel","help"],["href","https://drafts.csswg.org/css-anchor-position-1/#determining"]],"c":[]},"\n",{"t":"link","a":[["rel","author"],["title","Kiet Ho"],["href","mailto:kiet.ho@apple.com"]],"c":[]},"\n\n","\n","\n","\n","\n\n",{"t":"style","a":[],"c":["\n  .containing-block {\n    border: 1px solid black;\n\n    position: relative;\n    width: 500px;\n    height: 200px;\n  }\n\n  .box {\n    /* Can only use anchor-size() with position: absolute */\n    position: absolute;\n    background-color: green;\n    anchor-name: --box;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: white;\n  }\n\n  #box1 {\n    width: 50px;\n    height: 60px;\n  }\n\n  #box2, #box3, #box4, #box5 {\n    width: calc(anchor-size(--box width) + 10px);\n    height: calc(anchor-size(--box height) + 20px);\n  }\n\n  #box2 { left: 60px; }\n  #box3 { left: 130px; }\n  #box4 { left: 210px; }\n  #box5 { left: 300px; }\n"]},"\n\n"]},{"t":"body","a":[["onload","checkLayoutForAnchorPos('.target')"]],"c":["\n  ",{"t":"p","a":[],"c":["You should see a row of five rectangles growing in size in order."]},"\n\n  ",{"t":"div","a":[["class","containing-block"]],"c":["\n    ","\n    ",{"t":"div","a":[["class","box target"],["id","box1"],["data-expected-width","50"],["data-expected-height","60"]],"c":["1"],"v":{"width":50,"height":60}},"\n    ",{"t":"div","a":[["class","box target"],["id","box2"],["data-expected-width","60"],["data-expected-height","80"]],"c":["2"],"v":{"width":60,"height":80}},"\n    ",{"t":"div","a":[["class","box target"],["id","box3"],["data-expected-width","70"],["data-expected-height","100"]],"c":["3"],"v":{"width":70,"height":100}},"\n    ",{"t":"div","a":[["class","box target"],["id","box4"],["data-expected-width","80"],["data-expected-height","120"]],"c":["4"],"v":{"width":80,"height":120}},"\n    ",{"t":"div","a":[["class","box target"],["id","box5"],["data-expected-width","90"],["data-expected-height","140"]],"c":["5"],"v":{"width":90,"height":140}},"\n  "]},"\n\n"]}]}}
