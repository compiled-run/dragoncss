      {"call":".target","matched":5,"tree":{"t":"html","a":[],"c":[{"t":"head","a":[],"c":[{"t":"title","a":[],"c":["Tests that anchor layout changes in another BFC cause relayout on the anchored element"]},"\n",{"t":"link","a":[["rel","help"],["href","https://drafts.csswg.org/css-anchor-1/#propdef-anchor-name"]],"c":[]},"\n",{"t":"link","a":[["rel","author"],["href","mailto:xiaochengh@chromium.org"]],"c":[]},"\n","\n","\n","\n","\n",{"t":"style","a":[],"c":["\n.containing-block {\n  position: absolute;\n}\n.anchor {\n  anchor-name: --a1;\n  width: 50px;\n  height: 70px;\n  background: orange;\n}\n.after .anchor {\n  width: 70px;\n  height: 50px;\n}\n.target {\n  position: absolute;\n  left: anchor(--a1 right);\n  top: anchor(--a1 bottom);\n  width: anchor-size(--a1 width);\n  height: anchor-size(--a1 height);\n  background: green;\n}\n\n/* Various types of BFC as the containing block of the anchor */\n.float {\n  float: left;\n}\n.table {\n  display: table;\n}\n.inline-block {\n  display: inline-block;\n  vertical-align: bottom;\n}\n.contain {\n  contain: layout;\n}\n.scroller {\n  overflow: scroll;\n  width: 20px;\n  height: 20px;\n}\n"]},"\n"]},{"t":"body","a":[],"c":["\n  ",{"t":"div","a":[["class","containing-block"]],"c":["\n    ",{"t":"div","a":[["class","float"]],"c":["\n      ",{"t":"div","a":[["class","anchor"]],"c":[]},"\n    "]},"\n    ",{"t":"div","a":[["class","target"],["data-offset-x","50"],["data-offset-y","70"],["data-expected-width","50"],["data-expected-height","70"]],"c":[],"v":{"width":50,"height":70,"offset-x":50,"offset-y":70}},"\n  "]},"\n\n  ",{"t":"div","a":[["class","containing-block"]],"c":["\n    ",{"t":"div","a":[["class","table"]],"c":["\n      ",{"t":"div","a":[["class","anchor"]],"c":[]},"\n    "]},"\n    ",{"t":"div","a":[["class","target"],["data-offset-x","50"],["data-offset-y","70"],["data-expected-width","50"],["data-expected-height","70"]],"c":[],"v":{"width":50,"height":70,"offset-x":50,"offset-y":70}},"\n  "]},"\n\n  ",{"t":