      {"call":"[data-expected-height]","matched":23,"tree":{"t":"html","a":[],"c":[{"t":"head","a":[],"c":[{"t":"link","a":[["rel","help"],["href","https://drafts.csswg.org/css-sizing-4/#sizing-values"]],"c":[]},"\n",{"t":"link","a":[["rel","author"],["title","Daniel Holbert"],["href","mailto:dholbert@mozilla.com"]],"c":[]},"\n","\n","\n","\n",{"t":"meta","a":[["name","assert"],["content","min-block-size:stretch (setting 'min-height' in this case) resolves and clamps as expected (producing similar results as if we had specified the keyword for the block-size property)"]],"c":[]},"\n",{"t":"style","a":[],"c":["\n  .cb {\n    block-size: 50px;\n    inline-size: 40px;\n\n    /* This margin & border are purely cosmetic and don't impact the sizing\n     * calculations in this test: */\n    margin: 5px;\n    border: 2px solid black;\n\n    /* This padding only comes into play for the subtests with absolutely\n     * positioned children (where our padding-box forms the containing block\n     * for the abspos child). */\n    padding-block: 5px;\n    padding-inline: 3px;\n\n    /* We make each containing block an inline-level box, so we can display\n     * subtests in multiple rows, for easier visualization: */\n    display: inline-block;\n    vertical-align: top;\n  }\n\n  .test {\n    /* We have 2+3 = 5px of margin in the block axis. This means the stretched\n     * children should all have a border-box size that's 5px less than the\n     * containing block's content-box size, i.e. 50 - 5 = 45px. */\n    margin-block-start: 2px;\n    margin-block-end: 3px;\n\n    /* We also have some border/padding that UAs will need to account for\n     * when computing the stretched children's content-box sizes; but these\n     * don't reduce our `data-expected-height` expectations, since those\n     * correspond to the border-box size. */\n    border: 3px solid blue;\n    padding: 2px;\n\n    /* We expect \"min-block-size:stretch\" to cause the used value of\n     * \"block-size\" to be clamped to the \"stretch\" size. */\n    min-block-size: stretch;\n    block-size: 0;\n    inline-size: 20px;\n    background: fuchsia;\n  }\n"]},"\n","\n"]},{"t":"body","a":[["onload","runTests()"]],"c":["\n  ","\n  ",{"t":"div","a":[["class","cb"]],"c":["\n    ",{"t":"div","a":[["class","test"],["data-expected-height","45"]],"c":[],"v":{"height":45}},"\n  "]},"\n  ",{"t":"div","a":[["class","cb"]],"c":["\n    ",{"t":"canvas","a":[["class","test"],["data-expected-height","45"]],"c":[],"v":{"height":45}},"\n  "]},"\n  ",{"t":"div","a":[["class","cb"]],"c":["\n    ",{"t":"input","a":[["class","test"],["data-expected-height","45"]],"c":[],"v":{"height":45}},"\n  "]},"\n  ",{"t":"div","a":[["class","cb"]],"c":["\n    ",{"t":"textarea","a":[["class","test"],["data-expected-height","45"]],"c":[],"v":{"height":45}},"\n  "]},"\n  ",{"t":"div","a":[["class","cb"]],"c":["\n    ",{"t":"button","a":[["class","test"],["data-expected-height","45"]],"c":[],"v":{"height":45}},"\n  "]},"\n  ",{"t":"div","a":[["class","cb"]],"c":["\n    ",{"t":"div","a":[["class","test"],["style","float: left"],["data-expected-height","45"]],"c":[],"v":{"height":45}},"\n  "]},"\n\n  ",{"t":"br","a":[],"c":[]},"\n\n  ","\n  ","\n  ",{"t":"div","a":[["class","cb"],["style","position: relative"]],"c":["\n    ",{"t":"div","a":[["class","test"],["style","position: absolute; inset-block: 0;"],["data-expected-height","55"]],"c":[],"v":{"height":55}},"\n  "]},"\n\n  ","\n  ",{"t":"div","a":[["class","cb"],["style","position: relative"]],"c":["\n    ",{"t":"div","a":[["class","test"],["style","position: absolute"],["data-expected-height","50"]],"c":[],"v":{"height":50}},"\n  "]},"\n\n  ","\n  ",{"t":"div","a":[["class","cb"],["style","position: relative"]],"c":["\n    ",{"t":"div","a":[["class","test"],["style","position: absolute; inset-block-start: 10px"],["data-expected-height","45"]],"c":[],"v":{"height":45}},"\n  "]},"\n  ",{"t":"div","a":[["class","cb"],["style","position: relative"]],"c":["\n    ",{"