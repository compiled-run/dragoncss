<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic reftest written for packages/wpt (not a WPT file): an outline, which the box paint model does not draw. -->
<html xmlns="http://www.w3.org/1999/xhtml"><head><title>outline</title><link rel="match" href="boxes-ref.xht" /></head>
<body style="margin: 0"><div style="margin: 30px 0 0 20px; width: 100px; height: 100px; background-color: green; outline: 2px solid blue"></div></body></html>
