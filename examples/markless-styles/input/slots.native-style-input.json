	"css": ".box { display: flex; flex-direction: column; gap: 6px; padding: 8px; }\n.track { position: relative; height: 20px; background-color: rgb(220 220 220); }\n.thumb { position: absolute; top: 2px; left: var(--x, 0%); width: 16px; height: 16px; background-color: rgb(40 80 200); }\n.row { display: flex; height: 24px; }\n.panel { flex: var(--size, 1) 1 0; background-color: rgb(240 200 120); }\n.rest { flex: 1 1 0; background-color: rgb(120 200 160); }\n.bar { height: 12px; background-color: rgb(90 90 90); }\n.stack { margin-top: calc(var(--i, 0) * 6px); height: 10px; background-color: rgb(200 60 60); }\n.swatch { height: 18px; color: var(--tone); background-color: var(--tone); }\n.label { white-space: nowrap; font-size: 12px; }\n",
