{
  "name": "dragon-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc -b && tsc -b packages/text-shaper/test",
    "test": "vitest run",
    "regen": "node scripts/regen.ts",
    "setup:git": "git config merge.dragon-generated.name 'keep this side; pnpm regen rebuilds it' && git config merge.dragon-generated.driver true",
    "grammar:gen": "node scripts/gen-css-grammar.ts",
    "ua:capture": "node --conditions=dragon-internal scripts/capture-ua-defaults.ts",
    "parity:capture": "node --conditions=dragon-internal packages/parity/src/cli/capture.ts",
    "parity:report": "node --conditions=dragon-internal packages/parity/src/cli/report.ts",
    "layout:vectors": "node --conditions=dragon-internal packages/parity/src/cli/vectors.ts",
    "profile:rows": "node --conditions=dragon-internal scripts/gen-profile-rows.ts",
    "parity:platform-check": "node --conditions=dragon-internal packages/parity/src/cli/platform-check.ts",
    "parity:dpr-capture": "node --conditions=dragon-internal packages/parity/src/cli/dpr-capture.ts",
    "layout:dpr-vectors": "node --conditions=dragon-internal packages/parity/src/cli/dpr-vectors.ts",
    "layout:paint-vectors": "node --conditions=dragon-internal packages/parity/src/cli/paint-vectors.ts",
    "parity:dpr-report": "node --conditions=dragon-internal packages/parity/src/cli/dpr-report.ts",
    "parity:lanes": "node --conditions=dragon-internal packages/parity/src/cli/lanes.ts",
    "parity:devices": "node --conditions=dragon-internal packages/parity/src/cli/lanes.ts --run-host --run-device",
    "build": "node scripts/build-dist.ts",
    "pr:review": "node scripts/pr-review.ts",
    "train": "node scripts/merge-train.ts",
    "layout:subset": "node packages/translate/src/cli/subset.ts",
    "linebreak:gen": "node scripts/gen-linebreak-data.ts",
    "notices:gen": "node scripts/gen-third-party-notices.ts",
    "linebreak:conformance": "node scripts/gen-linebreak-data.ts --conformance",
    "native:gen": "node packages/translate/src/cli/gen.ts",
    "native:swift": "node packages/translate/src/cli/native.ts swift",
    "native:kotlin": "node packages/translate/src/cli/native.ts kotlin",
    "native:planted": "node packages/translate/src/cli/planted.ts",
    "north-star:check": "node --conditions=dragon-internal examples/music-player/tools/check.ts",
    "north-star:capture": "node --conditions=dragon-internal examples/music-player/tools/capture-chrome.ts",
    "wpt:run": "node --conditions=dragon-internal packages/wpt/src/cli/run.ts",
    "wpt:check": "node --conditions=dragon-internal packages/wpt/src/cli/check.ts",
    "wpt:update-expectations": "node --conditions=dragon-internal packages/wpt/src/cli/update.ts",
    "wpt:interop-labels": "node --conditions=dragon-internal packages/wpt/src/cli/interop-labels.ts",
    "native:build": "node --conditions=dragon-internal packages/parity/src/cli/native-build.ts",
    "native:smoke": "node --conditions=dragon-internal packages/parity/src/cli/native-smoke.ts",
    "native:encoders": "node --conditions=dragon-internal packages/parity/src/cli/native-encoders.ts",
    "text:build": "pnpm --dir packages/text-shaper run build",
    "text:gate": "node packages/text-shaper/scripts/gate.ts",
    "text:report": "node packages/text-shaper/scripts/report.ts",
    "layout:break-vectors": "node --conditions=dragon-internal packages/parity/src/cli/break-vectors.ts",
    "parity:break-capture": "node --conditions=dragon-internal packages/parity/src/cli/break-capture.ts",
    "parity:pixel-capture": "node --conditions=dragon-internal packages/parity/src/cli/pixel-capture.ts",
    "parity:glyph-calibration": "node --conditions=dragon-internal packages/parity/src/cli/glyph-calibration.ts",
    "parity:glyph-b3": "node --conditions=dragon-internal packages/parity/src/cli/glyph-b3.ts",
    "native:devices": "node --conditions=dragon-internal packages/parity/src/cli/native-devices.ts",
    "native:gallery": "node --conditions=dragon-internal packages/parity/src/cli/gallery.ts",
    "rt:oracle": "node --conditions=dragon-internal scripts/capture-rt-oracle.ts",
    "tw:sweep": "node --conditions=dragon-internal packages/tailwind-sweep/src/cli/sweep.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@webref/css": "8.7.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
