{
  "name": "dragon-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "grammar:gen": "node scripts/gen-css-grammar.ts",
    "ua:capture": "node --conditions=dragon-internal scripts/capture-ua-defaults.ts",
    "parity:capture": "node --conditions=dragon-internal packages/parity/src/cli/capture.ts",
    "parity:report": "node --conditions=dragon-internal packages/parity/src/cli/report.ts",
    "layout:vectors": "node --conditions=dragon-internal packages/parity/src/cli/vectors.ts",
    "profile:rows": "node --conditions=dragon-internal scripts/gen-profile-rows.ts",
    "parity:platform-check": "node --conditions=dragon-internal packages/parity/src/cli/platform-check.ts",
    "parity:dpr-capture": "node --conditions=dragon-internal packages/parity/src/cli/dpr-capture.ts",
    "layout:dpr-vectors": "node --conditions=dragon-internal packages/parity/src/cli/dpr-vectors.ts",
    "parity:dpr-report": "node --conditions=dragon-internal packages/parity/src/cli/dpr-report.ts",
    "parity:lanes": "node --conditions=dragon-internal packages/parity/src/cli/lanes.ts",
    "build": "node scripts/build-dist.ts",
    "layout:subset": "node packages/translate/src/cli/subset.ts",
    "native:gen": "node packages/translate/src/cli/gen.ts",
    "native:swift": "node packages/translate/src/cli/native.ts swift",
    "native:kotlin": "node packages/translate/src/cli/native.ts kotlin",
    "native:planted": "node packages/translate/src/cli/planted.ts",
    "wpt:run": "node --conditions=dragon-internal packages/wpt/src/cli/run.ts",
    "wpt:check": "node --conditions=dragon-internal packages/wpt/src/cli/check.ts",
    "wpt:update-expectations": "node --conditions=dragon-internal packages/wpt/src/cli/update.ts",
    "wpt:interop-labels": "node packages/wpt/src/cli/interop-labels.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@webref/css": "8.7.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
