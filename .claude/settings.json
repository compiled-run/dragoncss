{
  "subagentPromptCacheTtl": "1h",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(sleep:*)",
      "Bash(test:*)",
      "Bash(cd:*)",
      "Bash(pwd)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(tee:*)",
      "Bash(xargs:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(python3:*)",
      "Bash(for:*)",
      "Bash(while:*)",
      "Bash(if:*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push origin master:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git push origin HEAD:refs/heads/master:*)",
      "Bash(git push -u origin master:*)",
      "Bash(git push -u origin HEAD:master:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin --force-with-lease:*)",
      "Bash(git push origin +:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git push origin -d:*)",
      "Bash(git push origin ::*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --all:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh release:*)",
      "Bash(gh api -X PUT repos/compiled-run/dragoncss/pulls:*)",
      "Bash(gh api -X DELETE repos/compiled-run/dragoncss/git:*)",
      "Bash(gh api -X DELETE repos/compiled-run/dragoncss/branches:*)",
      "Bash(gh api -X PUT repos/compiled-run/dragoncss/branches:*)",
      "Bash(gh api -X PATCH repos/compiled-run/dragoncss/branches:*)",
      "Bash(gh api -X POST repos/compiled-run/dragoncss/merges:*)",
      "Bash(gh api -X PATCH repos/compiled-run/dragoncss/git:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)"
    ]
  }
}
